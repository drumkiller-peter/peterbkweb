---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title={`Page not found · ${profile.name}`} description="This page doesn't exist. Head back to the home page to see my work." noindex>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label={`${profile.name}, home`}>
      <img src="/favicon.svg" alt="" width="40" height="40" />
      <span>{profile.name}</span>
    </a>
  </header>

  <main id="main">
    <section class="intro wrap" aria-labelledby="nf-title">
      <div class="intro-text">
        <p class="eyebrow">404</p>
        <h1 id="nf-title">This page doesn't <em>exist</em>.</h1>
        <p class="lede">The link may be old or mistyped. Everything on this site lives on the home page.</p>
        <div class="actions">
          <a class="button" href="/">Go to the home page</a>
          <a class="text-link" href="/#work">See my work</a>
        </div>
      </div>
    </section>
  </main>
</Base>
