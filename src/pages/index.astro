---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { profile, featured, otherWork, experience, skills, education } from '../data/profile';
import portrait from '../assets/portrait.jpg';

const title = `${profile.name}, ${profile.role}`;
const description =
  'Flutter and Python developer in Nepal. Five years shipping cross-platform apps for mobile, web, desktop and wearables, plus the FastAPI backends behind them.';
const year = new Date().getFullYear();
---

<Base title={title} description={description}>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label="Peter BK, home">
      <img src="/favicon.svg" alt="" width="40" height="40" />
      <span>Peter BK</span>
    </a>
    <div class="header-end">
      <nav aria-label="Sections">
        <ul>
          <li><a href="#work">Work</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
        </svg>
      </button>
    </div>
  </header>

  <main id="main">
    <section class="intro wrap" aria-labelledby="intro-title">
      <Image
        class="portrait"
        src={portrait}
        alt="Portrait of Peter BK"
        widths={[160, 320, 640]}
        sizes="(min-width: 900px) 300px, 128px"
        loading="eager"
        fetchpriority="high"
      />
      <div class="intro-text">
        <p class="eyebrow">{profile.role} · {profile.location}</p>
        <h1 id="intro-title">
          I build Flutter apps that run on <em>every screen</em>, and the Python services they talk to.
        </h1>
        <p class="lede">{profile.summary}</p>
        <div class="actions">
          <a class="button" href={`mailto:${profile.email}`}>Email me</a>
          <a class="text-link" href={profile.resume} download>Résumé (PDF, 156 KB)</a>
        </div>
      </div>
    </section>

    <section id="work" class="section wrap" aria-labelledby="work-title">
      <h2 id="work-title" class="section-label">Selected work</h2>
      <div class="section-body">
        {featured.map((p, i) => (
          <article class="project">
            <header class="project-head">
              <span class="index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.name}</h3>
              <p class="meta">{p.platforms}</p>
            </header>
            <div class="project-body">
              <p>{p.summary}</p>
              <ul class="ticks">
                {p.details.map((d) => <li>{d}</li>)}
              </ul>
              <p class="stack"><span class="visually-hidden">Built with: </span>{p.stack.join(' / ')}</p>
              {p.link && (
                <p><a class="text-link" href={p.link.href} rel="noopener">{p.link.label}<span aria-hidden="true"> ↗</span></a></p>
              )}
            </div>
            {p.shots && (
              <ul class="shots" aria-label={`${p.name} screenshots`}>
                {p.shots.map((s) => (
                  <li>
                    <Image src={s.src} alt={s.alt} widths={[320, 640]} sizes="(min-width: 900px) 240px, 45vw" loading="lazy" />
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}

        <div class="other">
          <h3 class="minor-title">Also shipped</h3>
          <dl class="pairs">
            {otherWork.map((w) => (
              <div>
                <dt>
                  {w.href ? (
                    <a class="text-link" href={w.href} rel="noopener">{w.name}<span aria-hidden="true"> ↗</span></a>
                  ) : w.name}
                </dt>
                <dd>{w.note}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section id="experience" class="section wrap" aria-labelledby="exp-title">
      <h2 id="exp-title" class="section-label">Experience</h2>
      <ol class="section-body jobs">
        {experience.map((j) => (
          <li class="job">
            <p class="meta period">{j.period}</p>
            <div>
              <h3>{j.role}, <span class="company">{j.company}</span></h3>
              {j.note && <p class="note">{j.note}</p>}
              <ul class="ticks">
                {j.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section wrap" aria-labelledby="skills-title">
      <h2 id="skills-title" class="section-label">Toolkit</h2>
      <div class="section-body">
        <dl class="pairs skills">
          {skills.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
        <h3 class="minor-title">Education</h3>
        <dl class="pairs">
          {education.map((e) => (
            <div>
              <dt>{e.period}</dt>
              <dd>{e.title}, {e.place}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="contact" class="section contact wrap" aria-labelledby="contact-title">
      <h2 id="contact-title" class="section-label">Contact</h2>
      <div class="section-body">
        <p class="contact-lead">
          Working on an app that has to hold up offline, across devices, for a long time? I'd like to hear about it.
        </p>
        <a class="big-link" href={`mailto:${profile.email}`}>{profile.email}</a>
        <ul class="inline-links">
          <li><a class="text-link" href={profile.links.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a class="text-link" href={profile.links.github} rel="me noopener">GitHub</a></li>
          <li><a class="text-link" href={profile.resume} download>Résumé</a></li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer wrap">
    <p>© {year} Peter BK</p>
    <p><a href="#main">Back to top</a></p>
  </footer>
</Base>
